  "acceptance_criteria": {
    "AC-01": {
      "description": "告警被认证、校验并稳定去重，未授权和无效告警不启动调查。"
    },
    "AC-02": {
      "description": "事故与任务在 PostgreSQL 中持久化，API/worker 重启后可恢复。"
    },
    "AC-03": {
      "description": "调查任务有界重试、明确终态、幂等投递且不泄露凭据。"
    },
    "AC-04": {
      "description": "真实 Holmes 对 OpenObserve 做只读调查，并为确定结论保留可核验证据。"
    },
    "AC-05": {
      "description": "本地事故工作台展示任务状态、Trace、结论和证据，不提供隐式处置写操作。"
    },
    "AC-06": {
      "description": "本地启动、确定性测试和根因回放可重复，mock/live 结果分开报告。"
    },
    "AC-07": {
      "description": "生产身份、资源归属与角色授权覆盖数据查询、审批和执行入口，未授权请求无副作用。"
    },
    "AC-08": {
      "description": "应用可按确认的平台部署，完成健康检查、密钥注入、升级回滚及数据库备份恢复演练。"
    },
    "AC-09": {
      "description": "生产动作仅执行逐项白名单且经动作拥有方授权和审批的请求，支持幂等、审计、执行后验证和失败回退。"
    },
    "AC-10": {
      "description": "生产发布、知识、聚类与故障评测按确认的提供方和阈值可重复验证，live 与 mock 结果清楚区分。"
    }
  },
