\set ON_ERROR_STOP on

-- Run as a database administrator against a fresh AIOps database before the
-- first migration. Set passwords or bind managed identities outside this file.
SELECT 'CREATE ROLE aiops_runtime LOGIN'
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'aiops_runtime')
\gexec

SELECT 'CREATE ROLE aiops_migrator LOGIN'
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'aiops_migrator')
\gexec

SELECT 'CREATE ROLE aiops_worker LOGIN'
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'aiops_worker')
\gexec

SELECT 'CREATE ROLE aiops_break_glass NOLOGIN'
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'aiops_break_glass')
\gexec

ALTER ROLE aiops_break_glass NOLOGIN;

SELECT format('GRANT CONNECT ON DATABASE %I TO aiops_runtime, aiops_migrator, aiops_worker, aiops_break_glass', current_database())
\gexec

GRANT USAGE ON SCHEMA public TO aiops_runtime;
GRANT USAGE ON SCHEMA public TO aiops_break_glass;
GRANT USAGE, CREATE ON SCHEMA public TO aiops_migrator;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO aiops_runtime;
REVOKE DELETE ON ALL TABLES IN SCHEMA public FROM aiops_runtime;
GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO aiops_runtime;

-- Audit history is append-only for the application identity, including when
-- this bootstrap is rerun against an existing database.
DO $$
BEGIN
    IF to_regclass('public.audit_events') IS NOT NULL THEN
        EXECUTE 'REVOKE UPDATE, DELETE, TRUNCATE ON TABLE public.audit_events FROM aiops_runtime';
        EXECUTE 'REVOKE UPDATE, DELETE, TRUNCATE ON TABLE public.audit_events FROM PUBLIC';
    END IF;

    IF to_regclass('public.schema_migrations') IS NOT NULL THEN
        EXECUTE 'REVOKE INSERT, UPDATE, DELETE, TRUNCATE ON TABLE public.schema_migrations FROM aiops_runtime';
    END IF;
    IF to_regclass('public.users') IS NOT NULL THEN
        EXECUTE 'REVOKE INSERT, UPDATE ON TABLE public.users FROM aiops_runtime, PUBLIC';
        IF (SELECT count(*) FROM information_schema.columns
            WHERE table_schema = 'public' AND table_name = 'users'
              AND column_name IN ('id', 'username', 'password_hash', 'role', 'resource_scopes', 'active', 'created_at', 'oidc_issuer', 'oidc_subject', 'session_generation', 'reactivation_requested_at')) = 11 THEN
            EXECUTE 'REVOKE INSERT (id, username, password_hash, role, resource_scopes, active, created_at, oidc_issuer, oidc_subject, session_generation, reactivation_requested_at) ON TABLE public.users FROM aiops_runtime, PUBLIC';
            EXECUTE 'REVOKE UPDATE (id, username, password_hash, role, resource_scopes, active, created_at, oidc_issuer, oidc_subject, session_generation, reactivation_requested_at) ON TABLE public.users FROM aiops_runtime, PUBLIC';
            EXECUTE 'GRANT INSERT (id, username, password_hash, role, resource_scopes, active, oidc_issuer, oidc_subject) ON TABLE public.users TO aiops_runtime';
            EXECUTE 'GRANT UPDATE (username, password_hash, role, resource_scopes, active, session_generation, reactivation_requested_at) ON TABLE public.users TO aiops_runtime';
        END IF;
    END IF;

    IF to_regclass('public.oidc_login_transactions') IS NOT NULL THEN
        EXECUTE 'GRANT DELETE ON TABLE public.oidc_login_transactions TO aiops_runtime';
    END IF;
    IF to_regclass('public.revoked_sessions') IS NOT NULL THEN
        EXECUTE 'GRANT DELETE ON TABLE public.revoked_sessions TO aiops_runtime';
    END IF;
    IF to_regclass('public.break_glass_recovery_requests') IS NOT NULL THEN
        EXECUTE 'REVOKE ALL ON TABLE public.break_glass_recovery_requests FROM aiops_runtime, aiops_worker, aiops_break_glass, PUBLIC';
    END IF;
    IF to_regclass('public.break_glass_recovery_requests_id_seq') IS NOT NULL THEN
        EXECUTE 'REVOKE ALL ON SEQUENCE public.break_glass_recovery_requests_id_seq FROM aiops_runtime, aiops_worker, aiops_break_glass, PUBLIC';
    END IF;
    IF to_regprocedure('public.break_glass_reactivate_admin(uuid,text,text,text,boolean)') IS NOT NULL THEN
        EXECUTE 'REVOKE ALL ON FUNCTION public.break_glass_reactivate_admin(uuid,text,text,text,boolean) FROM PUBLIC, aiops_runtime, aiops_worker, aiops_break_glass';
    END IF;
    IF to_regprocedure('public.request_break_glass_admin_recovery(uuid,text)') IS NOT NULL THEN
        EXECUTE 'REVOKE ALL ON FUNCTION public.request_break_glass_admin_recovery(uuid,text) FROM PUBLIC, aiops_runtime, aiops_worker';
        EXECUTE 'GRANT EXECUTE ON FUNCTION public.request_break_glass_admin_recovery(uuid,text) TO aiops_break_glass';
    END IF;
    IF to_regprocedure('public.approve_break_glass_admin_recovery(bigint,boolean)') IS NOT NULL THEN
        EXECUTE 'REVOKE ALL ON FUNCTION public.approve_break_glass_admin_recovery(bigint,boolean) FROM PUBLIC, aiops_runtime, aiops_worker';
        EXECUTE 'GRANT EXECUTE ON FUNCTION public.approve_break_glass_admin_recovery(bigint,boolean) TO aiops_break_glass';
    END IF;

END
$$;

REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM aiops_worker;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM aiops_worker;

DO $$
BEGIN
    IF to_regclass('public.incidents') IS NOT NULL THEN
        EXECUTE 'GRANT SELECT ON TABLE public.incidents TO aiops_worker';
    END IF;
    IF to_regclass('public.tasks') IS NOT NULL THEN
        EXECUTE 'GRANT SELECT ON TABLE public.tasks TO aiops_worker';
        EXECUTE 'GRANT UPDATE (status, attempt, started_at, lease_expires_at, result, completed_at, error_code, available_at, updated_at) ON TABLE public.tasks TO aiops_worker';
    END IF;
    IF to_regclass('public.audit_events') IS NOT NULL THEN
        EXECUTE 'GRANT INSERT (incident_id, task_id, event_type, details) ON TABLE public.audit_events TO aiops_worker';
        EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO aiops_worker', pg_get_serial_sequence('public.audit_events', 'id'));
        EXECUTE 'REVOKE UPDATE, DELETE, TRUNCATE ON TABLE public.audit_events FROM aiops_worker';
    END IF;
    IF to_regclass('public.outbox_events') IS NOT NULL THEN
        EXECUTE 'GRANT SELECT ON TABLE public.outbox_events TO aiops_worker';
        EXECUTE 'GRANT UPDATE (last_enqueued_at, delivery_attempts, published_at) ON TABLE public.outbox_events TO aiops_worker';
        IF EXISTS (
            SELECT 1 FROM information_schema.columns
            WHERE table_schema = 'public' AND table_name = 'outbox_events' AND column_name = 'dead_lettered_at'
        ) THEN
            EXECUTE 'REVOKE UPDATE (dead_lettered_at) ON TABLE public.outbox_events FROM aiops_worker';
            EXECUTE 'GRANT UPDATE (dead_lettered_at) ON TABLE public.outbox_events TO aiops_runtime';
        END IF;
    END IF;
END
$$;

ALTER DEFAULT PRIVILEGES FOR ROLE aiops_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE ON TABLES TO aiops_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE aiops_migrator IN SCHEMA public
    GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO aiops_runtime;
