    "@opentelemetry/semantic-conventions": "^1.28.0",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
