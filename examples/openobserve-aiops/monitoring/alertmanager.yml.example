# Incident RBAC is derived from the stable `service` label on each alert.
# This route groups on `cluster` only when the alert itself carries that label.
# Add stable service and cluster/source labels before aggregating multiple services/clusters.
route:
  receiver: holmes-aiops
  group_by: [cluster, alertname, service, namespace, instance]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: holmes-aiops
    webhook_configs:
      - url: https://incident-api.example.internal/webhooks/prometheus-alertmanager
        send_resolved: false
        # The receiver accepts up to 100 alerts and rejects any truncated notification.
        # Keep alert groups below this limit; tune grouping and alert volume for the target.
        max_alerts: 100
        # Keep this example compatible with Alertmanager v0.27; per-webhook timeout
        # is available in newer releases only.
        http_config:
          authorization:
            type: Bearer
            credentials_file: /run/secrets/alertmanager-webhook-token
