max_steps: 12
custom_skill_paths:
  - /etc/holmes/skills
toolsets:
  openobserve:
    enabled: true
    config:
      api_url: "http://openobserve-proxy:8090"
      organization: "default"
      username: "{{ env.OPENOBSERVE_PROXY_USERNAME }}"
      password: "{{ env.OPENOBSERVE_PROXY_PASSWORD }}"
      verify_ssl: true
      timeout_seconds: 30
      max_window_seconds: 3600
      max_rows: 100
      allowed_streams:
        - app_logs
        - frontend_errors
